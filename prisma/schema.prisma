generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Artwork {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  description String?
  imageUrl    String
  category    String
  tags        String[]
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIImage {
  id        String   @id @default(cuid())
  prompt    String
  imageUrl  String
  style     String?
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  name        String
  email       String
  description String
  imageUrl    String?
  budget      String?
  dimensions  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Note: legacy `AIImage` and `Order` models above are unused — the live
// tables are `ai_images` (GeneratedImage, below), `commandes` (accessed
// directly via the Supabase client, no Prisma model), and `user_credits`.

model GeneratedImage {
  id             String   @id @default(cuid())
  supabaseUserId String?  @map("supabase_user_id")
  prompt         String
  imageUrl       String   @map("image_url")
  style          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ai_images")
  @@index([supabaseUserId])
}

// Identity (email / password) lives in Supabase Auth (`auth.users`) — this
// table only holds the generation quota keyed by that user id.
model UserCredits {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique @map("supabase_user_id")
  paidCredits    Int      @default(0) @map("paid_credits")
  // Total generations charged to the account. The first
  // FREE_GENERATION_LIMIT of them are free; the rest consume paidCredits.
  imagesGenerated Int     @default(0) @map("images_generated")
  // "free" until a Stripe checkout completes, then "paid".
  paymentStatus  String   @default("free") @map("payment_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_credits")
}

model UserProfile {
  id             String   @id @default(cuid())
  supabaseUserId String   @unique @map("supabase_user_id")
  fullName       String?  @map("full_name")
  address        String?
  city           String?
  postalCode     String?  @map("postal_code")
  country        String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model ProcessedStripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_stripe_events")
}

// Saved quiz outcome (and its private generated image). The table, its limit
// trigger, RLS and the private quiz-images bucket are created by supabase/quiz_results.sql,
// not by prisma migrate. Writes are server-side only: profile, config and
// image_path are always computed by the server, never taken from the client.
model QuizResult {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  code             String
  profile          String
  config           Json
  locale           String    @default("fr")
  promptKey        String?   @map("prompt_key")
  imagePath        String?   @map("image_path")
  imageGeneratedAt DateTime? @map("image_generated_at") @db.Timestamptz(6)
  generatingSince  DateTime? @map("generating_since") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, code])
  @@index([userId, createdAt(sort: Desc)])
  @@map("quiz_results")
}
